# MMBasic Anywhere - ESP32-S3 shared sdkconfig (PSRAM-independent).
#
# Used by both the octal (ports/esp32_s3) and quad (ports/esp32_s3_quad)
# ports, each combined with its own sdkconfig.psram.* fragment. Everything
# here is identical across PSRAM line modes — including WiFi, whose working
# memory prefers PSRAM at runtime and falls back to internal RAM, so it
# works on octal, quad, and no-PSRAM boards alike (see "WiFi" below).

# --- Console ----------------------------------------------------------------
# Use the chip's built-in USB Serial/JTAG controller for stdio. Same USB-C
# cable handles flashing and console; no external UART adapter needed.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Flash ------------------------------------------------------------------
# Keep the default image compatible with common ESP32-S3 modules. Larger
# 8/16 MB boards still run this 4 MB layout.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- Stack ------------------------------------------------------------------
# Keep enough stack for the BASIC parser/REPL, but do not burn 24 KB of scarce
# internal RAM before USB host and WiFi have started.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- CPU --------------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# --- Compiler ---------------------------------------------------------------
# -O2 for the application image; the interpreter/bytecode bridge are
# branch-heavy enough that ESP-IDF's debug -Og default is not representative.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Watchdog ---------------------------------------------------------------
# Disable the task watchdog entirely. With it on (~5s default), long-running
# BASIC FOR loops would trip it and reboot. Hard requirement for any
# non-trivial BASIC program.
CONFIG_ESP_TASK_WDT_INIT=n

# --- Radios -----------------------------------------------------------------
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_BT_ENABLED=n

# --- WiFi: PSRAM-preferred working memory, internal-RAM DMA buffers ---------
# SPIRAM_TRY_ALLOCATE_WIFI_LWIP is a runtime preference, not a hard PSRAM
# dependency: wifi_malloc/lwIP allocate via heap_caps_*_prefer(SPIRAM,
# INTERNAL), so on a no-PSRAM board (or after a PSRAM init failure under
# SPIRAM_IGNORE_NOTFOUND) every allocation falls back to internal RAM and
# WiFi still comes up. On PSRAM boards it moves the driver's ~50+ KB of
# control/management memory off the ~120 KB internal heap — without it,
# esp_wifi_init exhausts internal RAM and fails allocating its static RX
# buffers ("wifi:malloc buffer fail / Expected to init 6 rx buffer").
# DMA-bound buffers (static RX, TX frames) always come from internal RAM
# via the blob's *_internal allocator hooks regardless of this option.
# With SPIRAM_IGNORE_NOTFOUND set, Kconfig keeps the TX path in the
# no-PSRAM shape (dynamic TX, no cache-TX buffers), which is what lets
# one image serve PSRAM and no-PSRAM boards alike.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=0
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# WPA3-SAE must stay enabled: with it compiled out, the WiFi blob's
# supplicant function table has NULL SAE entries, and associating with a
# WPA3 or WPA2/WPA3-transition AP calls through one at the auth frame —
# InstrFetchProhibited at PC=0, crash-looping until safe mode.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
# CONFIG_ESP_WIFI_ENABLE_SAE_PK is not set
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set

# --- TLS --------------------------------------------------------------------
# WEB MQTT CONNECT ... tls and WEB OPEN TCP CLIENT/STREAM ... tls verify the
# server against the ESP-IDF X.509 certificate bundle. The "common" subset
# (~70 KB of certs) covers the CAs signing public brokers and HTTPS APIs;
# the full bundle costs another ~60 KB of the 2 MB app partition for CAs
# BASIC programs are unlikely to meet.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# TLS sessions allocate from PSRAM with internal-RAM fallback
# (esp32_mbedtls_mem.c). Internal RAM is the scarce resource here — WiFi
# buffers, the MMBasic heap, and the esp-mqtt client task coexist with
# mbedTLS, and a TLS handshake needs more contiguous internal space than
# is reliably left (handshakes fail with mbedTLS *_ALLOC_FAILED errors).
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y

CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
# CONFIG_LWIP_IPV6 is not set
CONFIG_LWIP_MAX_ACTIVE_TCP=6
CONFIG_LWIP_MAX_LISTENING_TCP=4
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
# CONFIG_LWIP_TCP_QUEUE_OOSEQ is not set

# --- Cores ------------------------------------------------------------------
CONFIG_FREERTOS_UNICORE=n

# --- Partition table + FATFS -----------------------------------------------
# Custom partition table: 2 MB app, internal LittleFS A:, and MMBasic
# option/flash-slot storage within a 4 MB flash image.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
