# MMBasic Anywhere - classic ESP32 CYD sdkconfig.
#
# Console: classic ESP32 has no USB Serial/JTAG controller; the IDF console
# stays on its UART0 default, and the MMBasic console drives UART0 through
# its own driver (main/esp32_cyd_console.c).

# --- Flash ------------------------------------------------------------------
# ESP32-2432S028R boards ship 4 MB WROOM-32 modules.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- Stack ------------------------------------------------------------------
# The IDF main task only spawns the MMBasic task (whose 32 KB stack comes
# from the post-scheduler heap) and exits; its own stack draws on the
# small early-boot DRAM pool, which .bss otherwise needs.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# --- CPU --------------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# --- Compiler ---------------------------------------------------------------
# -O2 for the application image; the interpreter/bytecode bridge are
# branch-heavy enough that ESP-IDF's debug -Og default is not representative.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Legacy internal DAC ----------------------------------------------------
# The CYD speaker connector is GPIO26 through the onboard amp. IDF 5 exposes
# classic ESP32 GPIO25/26 DAC DMA only through the legacy I2S/DAC path, while
# this port also uses new-generation ADC/I2S drivers elsewhere.
CONFIG_ADC_SKIP_LEGACY_CONFLICT_CHECK=y
CONFIG_DAC_SKIP_LEGACY_CONFLICT_CHECK=y
CONFIG_I2S_SUPPRESS_DEPRECATE_WARN=y
CONFIG_I2S_SKIP_LEGACY_CONFLICT_CHECK=y

# --- Watchdog ---------------------------------------------------------------
# Disable the task watchdog entirely. With it on (~5s default), long-running
# BASIC FOR loops would trip it and reboot. Hard requirement for any
# non-trivial BASIC program.
CONFIG_ESP_TASK_WDT_INIT=n

# --- Radios -----------------------------------------------------------------
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_BT_ENABLED=n

# --- PSRAM ------------------------------------------------------------------
# Most CYD boards have no PSRAM, but some clones ship WROVER modules.
# SPIRAM_IGNORE_NOTFOUND probes at boot and continues cleanly when absent;
# hal_psram_esp32.c publishes PSRAMbase/PSRAMsize = 0 in that case and the
# MMBasic heap stays internal. On PSRAM boards, Wi-Fi/lwIP working memory
# prefers PSRAM (runtime preference with internal-RAM fallback).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- WiFi: conservative buffer counts for the small classic-ESP32 DRAM ------
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=0
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# WPA3-SAE must stay enabled: with it compiled out, the WiFi blob's
# supplicant function table has NULL SAE entries, and associating with a
# WPA3 or WPA2/WPA3-transition AP calls through one at the auth frame —
# InstrFetchProhibited at PC=0, crash-looping until safe mode.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
# CONFIG_ESP_WIFI_ENABLE_SAE_PK is not set
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set

# --- TLS --------------------------------------------------------------------
# Build parity with the S3 port for the skeleton bring-up. The CYD memory
# policy treats TLS as opt-in; trimming it (and measuring what that buys on
# the ~300 KB classic-ESP32 DRAM budget) is memory-policy work, not build
# configuration.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y

CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
# CONFIG_LWIP_IPV6 is not set
CONFIG_LWIP_MAX_ACTIVE_TCP=6
CONFIG_LWIP_MAX_LISTENING_TCP=4
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
# CONFIG_LWIP_TCP_QUEUE_OOSEQ is not set

# --- Cores ------------------------------------------------------------------
CONFIG_FREERTOS_UNICORE=n

# --- Partition table + FATFS -----------------------------------------------
# Custom partition table: 2 MB app, internal LittleFS A:, and MMBasic
# option/flash-slot storage within a 4 MB flash image.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# MQTT task stack: the no-PSRAM CYD profile runs MQTT from a ~10 KB
# fragmented heap; the 6144-byte default xTaskCreate fails there. The
# non-TLS client with the shallow HAL event handler fits in 4608.
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_TASK_STACK_SIZE=4608
CONFIG_MQTT_BUFFER_SIZE=512
# CONFIG_MQTT_TRANSPORT_SSL is not set
# CONFIG_MQTT_TRANSPORT_WEBSOCKET is not set
